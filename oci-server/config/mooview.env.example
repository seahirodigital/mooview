# MooView本体
NODE_ENV=production
PORT=3000

# Node.jsからPythonゲートウェイへの接続
MOOMOO_GATEWAY_URL=http://127.0.0.1:8787
MOOMOO_GATEWAY_KEY=INSTALL_SCRIPT_GENERATES_THIS_VALUE
MOOMOO_GATEWAY_AUTOSTART=false
MOOMOO_PYTHON=/opt/mooview/venv/bin/python

# Windows・Macで共有するチャート設定のサーバー保存
MOOVIEW_SHARED_SETTINGS=true
MOOVIEW_DATA_DIR=/var/lib/mooview

# PythonゲートウェイからOpenDへの接続
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_GATEWAY_HOST=127.0.0.1
MOOMOO_GATEWAY_PORT=8787

# Gemini機能を利用する場合だけ、OCI上の秘密ファイルへ値を設定する
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 企業開示DB。未設定の配信元は同期を行わず、画面は空状態で起動する
EDINET_API_KEY=
EDINET_DB_API_KEY=

# 新着通知に企業開示DBの画面URLを含める場合だけ設定する
MOOVIEW_PUBLIC_URL=

# Discord自動通知を利用する場合だけ、OCI上の秘密ファイルへWebhook URLを設定する
# 値はGit、ブラウザ設定、共有設定へ保存しない
DISCORD_WEBHOOK_URL=
MOOVIEW_DISCORD_AUTOMATION_ENABLED=true

# PlaywrightのChromium実行ファイルはmooviewユーザー専用領域へ保存する
PLAYWRIGHT_BROWSERS_PATH=/var/lib/mooview/ms-playwright
