[Unit]
Description=MooView用 Moomoo Pythonゲートウェイ
Requires=moomoo-opend.service
After=moomoo-opend.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mooview
Group=mooview
WorkingDirectory=/opt/mooview/app
EnvironmentFile=/etc/mooview/mooview.env
ExecStart=/opt/mooview/venv/bin/python /opt/mooview/app/moomoo_gateway.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
# Yahoo Financeのフォールバックへ外向きHTTPS通信を許可する。
# 待受はmoomoo_gateway.py側で127.0.0.1に限定する。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
